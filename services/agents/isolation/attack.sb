;; macOS sandbox profile for attack runs (defense in depth, NOT a full sandbox).
;; browser-use 1.0 runs model-written Python on the host as this user ("not a sandbox" per its own docs). In our runs
;; the agent ran `ps aux` looking for the server. This profile keeps that code away from what it must never see:
;; answer keys (repo quizzes and every worktree), API keys (.env files, the context folder), and personal credentials.
;; Params: REPO (this worktree), PROJECTS (parent dir), HOME.
(version 1)
(allow default)

;; Network: localhost only (the sandbox site, Chrome's debugging port, the egress proxy) plus local unix sockets.
;; Model API traffic leaves through isolation/egress_proxy.py, which only connects to the model API hosts.
(deny network-outbound)
(allow network-outbound (remote ip "localhost:*"))
(allow network-outbound (remote unix-socket))
(allow network-outbound (literal "/private/var/run/mDNSResponder"))

;; No process listing (ps/pgrep/top/lsof) and no shell-outs that reveal other processes.
(deny process-exec
  (literal "/bin/ps") (literal "/usr/bin/pgrep") (literal "/usr/bin/top") (literal "/usr/sbin/lsof")
  (literal "/usr/bin/pkill") (literal "/usr/bin/w") (literal "/usr/bin/who"))

;; Credentials and secrets.
(deny file-read*
  (regex #"/\.env(\.[^/]*)?$")
  (subpath (string-append (param "PROJECTS") "/sand-hacks-context"))
  (subpath (string-append (param "HOME") "/.ssh"))
  (subpath (string-append (param "HOME") "/.aws"))
  (subpath (string-append (param "HOME") "/.kaggle"))
  (subpath (string-append (param "HOME") "/.config/gh"))
  (subpath (string-append (param "HOME") "/.claude"))
  (literal (string-append (param "HOME") "/.zsh_history"))
  (literal (string-append (param "HOME") "/.netrc")))

;; Answer keys: every other project and worktree, and this repo's quiz sources and fixtures.
(deny file-read* (subpath (param "PROJECTS")))
(allow file-read*
  (subpath (string-append (param "REPO") "/services/agents"))
  (subpath (string-append (param "REPO") "/node_modules"))
  (literal (string-append (param "REPO") "/package.json"))
  (literal (param "REPO")) (literal (param "PROJECTS")))
;; The whole home folder is off limits except what the agent process needs to run (found the hard way: an agent stuck
;; at the voice probe listed and walked the home folder looking for the app's code).
(deny file-read* (subpath (param "HOME")))
(allow file-read*
  (subpath (string-append (param "REPO") "/services/agents"))
  (subpath (string-append (param "REPO") "/node_modules"))
  (subpath (string-append (param "HOME") "/.local/share/uv"))
  (subpath (string-append (param "HOME") "/.cache/uv"))
  (subpath (string-append (param "HOME") "/.config/browser-harness"))
  (subpath (string-append (param "HOME") "/.config/browseruse"))
  (subpath (string-append (param "HOME") "/Library/Caches/ms-playwright"))
  (subpath (string-append (param "HOME") "/Library/Application Support/Google/Chrome/Crashpad")))
;; stat() on ancestors (node's realpath) reveals no file contents and no directory listings.
(allow file-read-metadata (subpath (param "PROJECTS")) (literal (param "HOME")) (literal (string-append (param "HOME") "/Desktop")))
;; Rule order: later rules win in SBPL, so re-deny secrets inside the allowed agent dir too, and run.sh's work dir
;; (it holds the quiz JSON with answer keys; the attack receives that over stdin, opened before the sandbox starts).
(deny file-read* (regex #"/\.env(\.[^/]*)?$"))
(deny file-read* (subpath (param "WORK")))
