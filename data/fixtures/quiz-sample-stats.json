      "id": "sample-stats-q4",
      "quizId": "sample-stats",
      "stem": "A study finds a p-value of 0.03 at alpha = 0.05. Which statement is correct?",
      "type": "mcq",
      "choices": [
        {
          "id": "a",
          "text": "There is a 3% chance the null hypothesis is true"
        },
        {
          "id": "b",
          "text": "If the null were true, data this extreme would occur about 3% of the time"
        },
        {
          "id": "c",
          "text": "The effect is large"
        },
        {
          "id": "d",
          "text": "The alternative hypothesis is proven"
        }
      ],
      "answerKey": "b",
      "objective": "interpret a p-value",
      "originalItemId": null
